# MangaVerse Backend Environment Configuration
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mangaverse?retryWrites=true&w=majority
FRONTEND_ORIGINS=http://localhost:5173
USER_SESSION_SECRET=replace_with_64_character_random_hex_for_user_session
ADMIN_SESSION_SECRET=replace_with_64_character_random_hex_for_admin_session
GRIDFS_BUCKET_NAME=mangaFiles
TRUST_PROXY=false
USER_SESSION_MAX_AGE_MS=604800000
ADMIN_SESSION_MAX_AGE_MS=86400000
MAX_UPLOAD_FILE_SIZE_MB=25
MAX_CHAPTER_PAGES=150
